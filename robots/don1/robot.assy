links:
  - assembly: "//pub/robotics/multimodal/openvmp/robots/don1:link-base"
    name: link-base

  # The two ends of the robot. On coordinates: the turntable sits on the board
  # of the base, and neither of them declares a port yet
  # (//pub/robotics/multimodal/openvmp/parts).
  - assembly: "//pub/robotics/multimodal/openvmp/robots/don1:robot/corner"
    name: front
    location: [[272.5, 0, -4.5], [0, 0, 1], 0]

  - assembly: "//pub/robotics/multimodal/openvmp/robots/don1:robot/corner"
    name: rear
    location: [[-272.5, 0, -4.5], [0, 0, 1], 180]
