{% set G = "//pub/robotics/parts/gobilda" %}
{% set M = "//pub/std/metric/m" %}
# How assembly-worm and assembly-worm-gear fit together: the two pieces held
# by a channel at the distance of their centres, as in the drive modules of
# the base (link-base/motion), less what the motors bring. Every part is joined
# to another by its ports, so the tests hold this to everything an assembly
# can be checked for: that it is all connected, that nothing overlaps but what
# is declared (the worm's thread in the gear's teeth), and that it can be
# bought.
links:
  - part: {{ G }}:structure/u_channel_7
    name: channel

  # The worm, its first bearing in the top of the channel. The bearing may turn
  # in its seat, and that turns the worm: this one meshes the worm's thread with
  # the teeth of the gear.
  - assembly: //pub/robotics/multimodal/openvmp/robots/don1:assembly-worm
    name: worm
    connect:
      with: "{{ M }}:m14-shaft-4"
      withInstance: race-1
      withParams:
        turnZ: 300
      name: channel
      to: "{{ M }}:m14-thru-2.5"
      toInstance: top-inner-2
      # Meshing with the gear. The two models are not exact conjugates of each
      # other, so their flanks share about 1mm^3.
      interferes: worm-gear/gear

  # The gear shaft, in a bearing in each wall of the channel
  - part: {{ G }}:motion/bearing_flanged_8mmREX
    name: gear-bearing-1
    connect:
      with: "{{ M }}:m14-shaft-4"
      withParams:
        turnZ: 270
      name: channel
      to: "{{ M }}:m14-thru-2.5"
      toInstance: right-inner-3

  - part: {{ G }}:motion/shaft_8mmREX_72mm
    name: gear-shaft
    connect:
      with: {{ G }}:8mmREX-shaft
      withInstance: clean-side
      withParams:
        moveZ: 47.12
      name: gear-bearing-1
      to: {{ G }}:8mmREX-thru-5
      toInstance: flange-side
      toParams:
        turnZ: 120

  # The E-clip that comes with the shaft, in its groove
  - part: {{ G }}:motion/shaft_8mmREX_72mm_clip
    name: gear-shaft-clip
    connect:
      with: {{ G }}:8mmREX-thru-0.7
      withInstance: side1
      withParams:
        turnZ: 120
      name: gear-shaft
      to: {{ G }}:8mmREX-shaft
      toInstance: groove

  - part: {{ G }}:motion/bearing_flanged_8mmREX
    name: gear-bearing-2
    connect:
      with: "{{ M }}:m14-shaft-4"
      withParams:
        turnZ: 270
      name: channel
      to: "{{ M }}:m14-thru-2.5"
      toInstance: left-outer-3

  # The gear, on its hub on the gear shaft: the hub on the far side of the gear
  # from the collar, as there is no room for it between the two. Of the turns
  # the REX hex allows, this one meshes the gear's teeth with the worm's thread.
  - assembly: //pub/robotics/multimodal/openvmp/robots/don1:assembly-worm-gear
    name: worm-gear
    connect:
      with: {{ G }}:8mmREX-thru-10
      withInstance: flat
      withParams:
        turnZ: 240
      name: gear-shaft
      to: {{ G }}:8mmREX-shaft
      toInstance: clean-side
      toParams:
        moveZ: 14.6

  - part: {{ G }}:motion/collar_clamping_8mmREX
    name: gear-collar
    connect:
      with: {{ G }}:8mmREX-thru-9.5
      withInstance: rex5-back
      name: gear-shaft
      to: {{ G }}:8mmREX-shaft
      toInstance: clip
      toParams:
        moveZ: 20.94

  # The worm shaft, through both bearings of the worm
  - part: {{ G }}:motion/shaft_8mmREX_64mm
    name: worm-shaft
    connect:
      with: {{ G }}:8mmREX-shaft
      withInstance: clean-side
      name: worm
      to: {{ G }}:8mmREX-thru-5
      toInstance: bearing-2
      toParams:
        turnZ: 240
      # Through the worm's own REX bore too, which the models draw the same size
      # as the shaft.
      interferes: worm/worm

  - part: {{ G }}:structure/mount_quad_block
    name: worm-qbm
    connect:
      with: "{{ M }}:m-threaded-thru-depth;depth=8.5,size=4"
      withInstance: side1-0
      withParams:
        turnZ: 180
      name: channel
      to: "{{ M }}:m4-thru-2.5"
      toInstance: right-inner-3-1-10
      # Against the second bearing of the worm: the worm, its bearings and
      # spacers make a stack a little longer than the space between the top of
      # the channel and this mount, so it is pressed in, which holds the worm
      # tight.
      interferes: worm/worm-bearing-2
