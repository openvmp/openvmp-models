links:
  - part: //pub/robotics/parts/gobilda:motion/servo_attach_arm_25t
    name: arm

  # On coordinates: the stereo camera that this channel carries is not modelled
  # yet, and nothing on the arm meets anything on the channel - the two are 14mm
  # apart and at right angles to each other where they are drawn.
  - part: //pub/robotics/parts/gobilda:structure/u_channel_low_3
    name: channel
    location: [[-24.5, {{ 21.5 * param_dir }}, {{ 2 + 48 * param_dir }}], [1, 0, 0], {{ 180 + 90 * param_dir }}]
